# LookaRetro — Mupen64Plus-Next core options (Nintendo 64).
# Deployed to <RetroArch>/config/Mupen64Plus-Next/Mupen64Plus-Next.opt.
#
# GLideN64 (the core default) breaks on macOS: it uses legacy
# GL_TEXTURE_INDEX_2D fixed-function texture units that do not exist in
# macOS's OpenGL core profile — audio plays but the screen stays black.
#
# ParaLLEl-RDP renders via Vulkan (MoltenVK is bundled with RetroArch) and is
# GPU-accelerated and fast. Fallback: "angrylion" (software renderer, works
# everywhere, slower). macOS builds of this core have no CPU dynarec, so the
# GPU RDP is what keeps N64 playable here.
mupen64plus-rdp-plugin = "parallel"
mupen64plus-rsp-plugin = "parallel"

# --- Controle (N64 em pad Xbox) -----------------------------------------
# Mantém o mapeamento padrão que joga os C-buttons (amarelos) no ANALÓGICO
# DIREITO do pad — câmera/look sem largar o movimento. alt-map="False" é o
# padrão do core; deixamos explícito aqui para o setup reproduzir.
# (O layout fino de A/B/C está no remap Mupen64Plus-Next.rmp.)
mupen64plus-alt-map = "False"
